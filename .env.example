# Local demo only. Set your own local PostgreSQL password before starting Compose.
NODE_ENV=development
APP_MODE=demo
LOG_LEVEL=info
POSTGRES_USER=shared_vps
POSTGRES_PASSWORD=local_demo_password
POSTGRES_DB=shared_vps
POSTGRES_PORT=5432
DATABASE_URL=postgresql://shared_vps:local_demo_password@127.0.0.1:5432/shared_vps?schema=public&connect_timeout=3&connection_limit=5
# Integration tests use an isolated, automatically removed schema on this local DB.
TEST_DATABASE_URL=postgresql://shared_vps:local_demo_password@127.0.0.1:5432/shared_vps?schema=public&connect_timeout=3
API_HOST=127.0.0.1
API_PORT=3000
API_BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:3000
WEB_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:3000
TELEGRAM_BOT_TOKEN=

# Stage 1.1.1: Render injects PORT automatically. Do not set it locally.
# PORT=
# Cloud API: NODE_ENV=production, API_HOST=0.0.0.0,
# CORS_ORIGINS=<canonical HTTPS Web Service origin>,
# DATABASE_URL=<Neon pooled URL with sslmode=require&connect_timeout=15&connection_limit=3>
# Cloud web: VITE_API_BASE_URL=<actual HTTPS API origin> (public, never a secret).
# Manual GitHub workflow uses the protected secret NEON_MIGRATION_DATABASE_URL.
# MIGRATION_DATABASE_URL is passed only to that workflow step; use a direct SSL URL.

# Stage 1.2 canonical site/API origin. Production must use HTTPS.
# CORS_ORIGINS must contain the canonical PUBLIC_ORIGIN exactly.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Existing bot token above. Generate a unique random 32+ character webhook secret.
# Omit unset optional variables completely; do not set them to empty strings.
# TELEGRAM_WEBHOOK_SECRET=
# Stage 1.2.5 bot login uses the existing bot token and webhook secret.
# Telegram Login Client ID / Client Secret are not required.
# TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_IDS=

# Render Free: inline jobs run only while the existing API is awake.
# Use external only after provisioning an explicitly approved always-on worker.
BACKGROUND_MODE=inline
