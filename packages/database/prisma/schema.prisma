generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum IdentityProvider {
  TELEGRAM
  EMAIL
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  TEST
}

enum ServerProvider {
  MOCK
}

enum ServerStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
  TERMINATED
}

enum SlotStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum SettingType {
  INTEGER
  BOOLEAN
  STRING
  OBJECT
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  role          UserRole       @default(USER)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  identities    UserIdentity[]
  orders        Order[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  sessions Session[]
  tickets SupportTicket[]
  supportMessages SupportMessage[]
  incidentObservations IncidentObservation[]
  compensations SubscriptionCompensation[]
  botState BotState?
  loginRequests LoginRequest[]
  loginGrants LoginGrant[]
  notificationPreference NotificationPreference?

  @@index([status])
  @@index([createdAt, id])
  @@map("users")
}

model UserIdentity {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  provider       IdentityProvider
  providerUserId String           @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_identities")
}

model Plan {
  id                String         @id @default(uuid()) @db.Uuid
  code              String         @unique @db.VarChar(64)
  name              String         @db.VarChar(128)
  price             Int
  currency          String         @default("RUB") @db.Char(3)
  durationDays      Int            @map("duration_days")
  maxUsersPerServer Int            @map("max_users_per_server")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders            Order[]
  subscriptions     Subscription[]

  @@index([isActive])
  @@map("plans")
}

model Order {
  backgroundJobs BackgroundJob[]
  operationKey String? @unique @map("operation_key") @db.VarChar(160)
  renewalId String? @map("renewal_id") @db.Uuid
  renewal Subscription? @relation("Renewals", fields: [renewalId], references: [id], onDelete: Restrict)
  periodDays Int @default(30) @map("period_days")
  attempts Int @default(0)
  lastError String? @map("last_error") @db.VarChar(64)
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  planId       String          @map("plan_id") @db.Uuid
  status       OrderStatus     @default(AWAITING_PAYMENT)
  amount       Int
  currency     String          @default("RUB") @db.Char(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan         Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments     Payment[]
  subscription Subscription?

  @@unique([id, userId, planId])
  @@index([userId, createdAt])
  @@index([planId])
  @@index([status, createdAt])
  @@index([createdAt, id])
  @@index([userId, createdAt, id])
  @@map("orders")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider @default(TEST)
  externalPaymentId String?         @map("external_payment_id") @db.VarChar(255)
  amount            Int
  currency          String          @default("RUB") @db.Char(3)
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, externalPaymentId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

model Server {
  id               String         @id @default(uuid()) @db.Uuid
  provider         ServerProvider @default(MOCK)
  externalServerId String?        @map("external_server_id") @db.VarChar(255)
  status           ServerStatus   @default(PROVISIONING)
  monthlyCost      Int            @map("monthly_cost")
  currency         String         @default("RUB") @db.Char(3)
  capacity         Int
  rentedAt         DateTime?      @map("rented_at") @db.Timestamptz(3)
  expiresAt        DateTime?      @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  slots            ServerSlot[]
  incidents ServiceIncident[]

  @@unique([provider, externalServerId])
  @@index([status, expiresAt])
  @@index([createdAt, id])
  @@map("servers")
}

model ServerSlot {
  id            String         @id @default(uuid()) @db.Uuid
  serverId      String         @map("server_id") @db.Uuid
  slotNumber    Int            @map("slot_number")
  status        SlotStatus     @default(AVAILABLE)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  server        Server         @relation(fields: [serverId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@unique([serverId, slotNumber])
  @@index([status, serverId])
  @@map("server_slots")
}

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  planId       String             @map("plan_id") @db.Uuid
  orderId      String             @unique @map("order_id") @db.Uuid
  serverSlotId String?            @map("server_slot_id") @db.Uuid
  status       SubscriptionStatus @default(PENDING)
  startedAt    DateTime?          @map("started_at") @db.Timestamptz(3)
  expiresAt    DateTime?          @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan         Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  order        Order              @relation(fields: [orderId, userId, planId], references: [id, userId, planId], onDelete: Restrict)
  serverSlot   ServerSlot?        @relation(fields: [serverSlotId], references: [id], onDelete: Restrict)
  credentials  AccessCredential[]
  renewals Order[] @relation("Renewals")
  compensations SubscriptionCompensation[]

  @@unique([orderId, userId, planId])
  @@index([userId, status])
  @@index([planId])
  @@index([status, expiresAt])
  @@index([serverSlotId])
  @@index([createdAt, id])
  @@index([userId, createdAt, id])
  @@map("subscriptions")
}

model AccessCredential {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  demoIdentifier String       @unique @map("demo_identifier") @db.VarChar(128)
  metadata       Json         @default("{}")
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
  @@map("access_credentials")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(128)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([createdAt, id])
  @@map("audit_logs")
}

model Setting {
  id        String      @id @default(uuid()) @db.Uuid
  key       String      @unique @db.VarChar(128)
  valueType SettingType @map("value_type")
  value     Json
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

model Session {
  tokenHash String @id @map("token_hash") @db.VarChar(64)
  userId String? @map("user_id") @db.Uuid
  nonce String? @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([expiresAt])
  @@map("sessions")
}
model AuthReplay {
  hash String @id @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@map("auth_replays")
}
model SupportTicket {
  category String @default("OTHER") @db.VarChar(32)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  messages SupportMessage[]
  incidentId String? @map("incident_id") @db.Uuid
  incident ServiceIncident? @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  escalations ProviderEscalation[]
  operationKey String? @unique @map("operation_key") @db.VarChar(160)
  id String @id @default(uuid()) @db.Uuid
  number Int @unique @default(autoincrement())
  userId String @map("user_id") @db.Uuid
  text String @db.VarChar(4000)
  status String @default("OPEN") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([createdAt, id])
  @@index([userId, createdAt, id])
  @@map("support_tickets")
}
model BotState {
  userId String @id @map("user_id") @db.Uuid
  awaitingSupport Boolean @default(false) @map("awaiting_support")
  supportCategory String @default("OTHER") @map("support_category") @db.VarChar(32)
  activeTicketId String? @map("active_ticket_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("bot_states")
}
model TelegramUpdate {
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  sendStartedAt DateTime? @map("send_started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  lastError String? @map("last_error") @db.VarChar(64)
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(3)
  id Int @id
  payload Json
  response Json?
  status String @default("PENDING") @db.VarChar(32)
  attempts Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([status, createdAt])
  @@index([status, nextAttemptAt, id])
  @@index([status, leaseUntil])
  @@map("telegram_updates")
}

model LoginRequest {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  browserHash String @map("browser_hash") @db.VarChar(64)
  displayCode String @map("display_code") @db.VarChar(6)
  sessionHash String? @map("session_hash") @db.VarChar(64)
  telegramId String? @map("telegram_id") @db.VarChar(16)
  userId String? @map("user_id") @db.Uuid
  status String @default("PENDING") @db.VarChar(16)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([browserHash, status])
  @@index([expiresAt])
  @@map("login_requests")
}

model LoginGrant {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  operationKey String @unique @map("operation_key") @db.VarChar(80)
  kind String @db.VarChar(8)
  userId String @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, kind])
  @@index([expiresAt])
  @@map("login_grants")
}

model AuthLimit {
  key String @id @db.VarChar(64)
  attempts Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("auth_limits")
}

model BackgroundJob {
  orderId String? @map("order_id") @db.Uuid
  order Order? @relation(fields:[orderId], references:[id], onDelete:Restrict)
  id String @id @default(uuid()) @db.Uuid
  kind String @db.VarChar(32)
  key String @unique @db.VarChar(180)
  payload Json @default("{}")
  status String @default("PENDING") @db.VarChar(16)
  attempts Int @default(0)
  maxAttempts Int @default(8) @map("max_attempts")
  runAt DateTime @default(now()) @map("run_at") @db.Timestamptz(3)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  sendStartedAt DateTime? @map("send_started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  lastError String? @map("last_error") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(3)
  @@index([status, runAt, id])
  @@index([status, leaseUntil])
  @@index([finishedAt])
  @@index([orderId])
  @@index([createdAt, id])
  @@map("background_jobs")
}
model NotificationPreference {
  userId String @id @map("user_id") @db.Uuid
  remindersEnabled Boolean @default(false) @map("reminders_enabled")
  updatesEnabled Boolean @default(false) @map("updates_enabled")
  telegramBlocked Boolean @default(false) @map("telegram_blocked")
  nextSendAt DateTime @default(now()) @map("next_send_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  @@map("notification_preferences")
}
model DeliveryThrottle {
  key String @id @db.VarChar(32)
  nextAt DateTime @map("next_at") @db.Timestamptz(3)
  @@map("delivery_throttles")
}
model WorkerHeartbeat {
  id String @id @db.Uuid
  mode String @db.VarChar(16)
  status String @default("RUNNING") @db.VarChar(16)
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  lastCompletedAt DateTime? @map("last_completed_at") @db.Timestamptz(3)
  lastError String? @map("last_error") @db.VarChar(64)
  @@index([lastSeenAt])
  @@map("worker_heartbeats")
}

model SupportMessage {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  authorRole String @map("author_role") @db.VarChar(16)
  text String @db.VarChar(4000)
  operationKey String @unique @map("operation_key") @db.VarChar(180)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([ticketId, createdAt, id])
  @@map("support_messages")
}
model ServiceIncident {
  id String @id @default(uuid()) @db.Uuid
  operationKey String @unique @map("operation_key") @db.VarChar(180)
  component String @db.VarChar(32)
  serverId String? @map("server_id") @db.Uuid
  source String @default("DEMO") @db.VarChar(16)
  status String @default("SUSPECTED") @db.VarChar(16)
  diagnosis String @default("UNKNOWN") @db.VarChar(32)
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastResult String @default("UNKNOWN") @map("last_result") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  server Server? @relation(fields: [serverId], references: [id], onDelete: Restrict)
  observations IncidentObservation[]
  tickets SupportTicket[]
  escalations ProviderEscalation[]
  compensations SubscriptionCompensation[]
  @@index([status, startedAt])
  @@index([serverId, startedAt])
  @@map("service_incidents")
}
model IncidentObservation {
  id String @id @default(uuid()) @db.Uuid
  incidentId String @map("incident_id") @db.Uuid
  operationKey String @unique @map("operation_key") @db.VarChar(180)
  result String @db.VarChar(16)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)
  actorId String @map("actor_id") @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  incident ServiceIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  @@index([incidentId, checkedAt, id])
  @@map("incident_observations")
}
model ProviderEscalation {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid
  incidentId String @map("incident_id") @db.Uuid
  draft String @db.VarChar(4000)
  reviewedHash String? @map("reviewed_hash") @db.VarChar(64)
  status String @default("DRAFT") @db.VarChar(32)
  providerReply String? @map("provider_reply") @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  incident ServiceIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  @@unique([ticketId, incidentId])
  @@map("provider_escalations")
}
model SubscriptionCompensation {
  id String @id @default(uuid()) @db.Uuid
  incidentId String @map("incident_id") @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  operationKey String @unique @map("operation_key") @db.VarChar(180)
  hours Int
  reason String @db.VarChar(500)
  previousExpiry DateTime @map("previous_expiry") @db.Timestamptz(3)
  newExpiry DateTime @map("new_expiry") @db.Timestamptz(3)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  windowEnd DateTime @map("window_end") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  incident ServiceIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([incidentId, subscriptionId])
  @@index([subscriptionId, createdAt])
  @@map("subscription_compensations")
}
