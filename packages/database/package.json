{
  "name": "@shared-vps/database",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "tsx ../../scripts/database-cli.ts validate",
    "db:migrate": "tsx ../../scripts/database-cli.ts migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@shared-vps/runtime": "workspace:*",
    "@shared-vps/shared": "workspace:*"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
